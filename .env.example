# Copy to .env and adjust.

# Password of the "nautix" database user (required).
DB_PASSWORD=change-this-password

# Host port on which the application listens in plain HTTP.
HTTP_PORT=8080

# The session cookie is marked "Secure" because users reach the application
# through the HTTPS reverse proxy. Set to false only for a test over plain
# HTTP on a host other than localhost.
COOKIE_SECURE=true
